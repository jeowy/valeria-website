---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Valeria's Art Portfolio & Commission Funnel" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
	</head>
	<body>
		<div id="custom-cursor"></div>
		<slot />
		<style is:global>
			:root {
				/* ── Core brand palette ─────────────────────────────── */
				--color-lawn-green:      #4A6A58;  /* fuzzy Win2k lawn */
				--color-lawn-dark:       #344d3f;  /* lawn shadow/depth */
				--color-dusty-pink:      #D4849A;  /* Win2k folder pink */
				--color-pink-light:      #e8a8b8;  /* folder highlight   */
				--color-pink-shadow:     #a85c72;  /* folder shadow      */

				/* ── Maximalist accent palette ──────────────────────── */
				--color-marigold:        #FFB81C;
				--color-magenta:         #C2185B;
				--color-velvet-red:      #7B0D2A;
				--color-midnight-purple: #1E0030;
				--color-gold:            #C9A84C;
				--color-cream:           #F5E6C8;  /* warm off-white for text */

				/* ── Semantic tokens ────────────────────────────────── */
				--bg-main:     var(--color-midnight-purple);
				--bg-lawn:     var(--color-lawn-green);
				--text-main:   var(--color-cream);
				--text-accent: var(--color-dusty-pink);

				/* ── Typography ─────────────────────────────────────── */
				--font-heading: 'Playfair Display', serif;
				--font-body:    'Outfit', sans-serif;

				/* ── Borders ────────────────────────────────────────── */
				--border-pink:  3px solid var(--color-dusty-pink);
				--border-gold:  3px solid var(--color-gold);
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
				cursor: none !important;
			}

			html {
				font-family: var(--font-body);
				background: var(--bg-main);
				color: var(--text-main);
				overflow-x: hidden;
			}

			/* ─────────────────────────────────────────────────────────
			   FUZZY LAWN background utility
			   Layered CSS noise for a high-res, dense fuzz effect
			───────────────────────────────────────────────────────── */
			.fuzzy-lawn {
				background-color: #4A6A58;
				position: relative;
			}
			.fuzzy-lawn::before, body::before {
				content: "";
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				opacity: 0.18;
				pointer-events: none;
				z-index: 0;
				/* Layering two noise frequencies for higher density/resolution */
				background-image: 
					url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter1'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter1)'/%3E%3C/svg%3E"),
					url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter2'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.4' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter2)'/%3E%3C/svg%3E");
				mix-blend-mode: multiply;
			}

			/* Default body: lawn texture */
			body {
				min-height: 100vh;
				background-color: #4A6A58;
				position: relative;
			}

			h1, h2, h3, h4 {
				font-family: var(--font-heading);
				letter-spacing: 2px;
			}

			/* ─────────────────────────────────────────────────────────
			   Y2K BUBBLE CURSOR — Tight, performant, and TRANSPARENT
			───────────────────────────────────────────────────────── */
			#custom-cursor {
				width: 24px;
				height: 24px;
				position: fixed;
				top: 0;
				left: 0;
				pointer-events: none;
				z-index: 9999;
				transform: translate(-50%, -50%);
				will-change: transform;
				border-radius: 50%;
				
				/* Sharp Y2K outline */
				border: 1px solid rgba(0, 0, 0, 0.4);
				
				/* Transparent high-contrast bubble effect */
				background: radial-gradient(circle at 30% 30%, 
					rgba(255, 255, 255, 0.6) 0%, 
					rgba(212, 132, 154, 0.2) 40%, 
					rgba(168, 92, 114, 0.1) 100%);
				
				box-shadow: 1px 1px 4px rgba(0,0,0,0.1);
				transition: transform 0.05s ease-out;
			}

			/* Secondary pointer bubble */
			#custom-cursor::after {
				content: '';
				position: absolute;
				width: 10px;
				height: 10px;
				top: -4px;
				left: -4px;
				border-radius: 50%;
				border: 1px solid rgba(0, 0, 0, 0.3);
				background: radial-gradient(circle at 30% 30%, 
					rgba(255, 255, 255, 0.5) 0%, 
					rgba(255, 184, 28, 0.2) 50%, 
					rgba(184, 134, 11, 0.1) 100%);
			}

			#custom-cursor.clicking {
				transform: translate(-50%, -50%) scale(0.8);
				filter: brightness(1.2) contrast(1.2);
			}

			/* ─────────────────────────────────────────────────────────
			   WIN2K FOLDER  — Pure CSS, tab integrated via pseudo-element
			───────────────────────────────────────────────────────── */
			.win2k-folder {
				display: inline-flex;
				flex-direction: column;
				align-items: center;
				gap: 12px;
				text-align: center;
				position: relative;
				transition: transform 0.15s ease;
				text-decoration: none !important;
				width: 110px;
			}
			.win2k-folder:hover {
				transform: translateY(-5px);
			}

			/* Main folder icon container */
			.win2k-folder .folder-icon {
				width: 100px;
				height: 72px;
				background: var(--color-dusty-pink);
				border-radius: 0 4px 4px 4px;
				position: relative;
				/* Margin top to make room for the absolute-positioned tab */
				margin-top: 14px;
				box-shadow:
					inset 0 2px 2px rgba(255,255,255,0.4),
					inset 0 -2px 2px rgba(0,0,0,0.2),
					4px 8px 15px rgba(0,0,0,0.4);
				transition: background 0.15s ease;
			}

			/* The Tab — Absolutely positioned and physically part of the body */
			.win2k-folder .folder-icon::before {
				content: '';
				position: absolute;
				top: -14px; /* Matches the margin-top */
				left: 0;
				width: 44px;
				height: 15px; /* Slightly taller to overlap the body by 1px */
				background: var(--color-pink-light);
				border-radius: 4px 8px 0 0;
				box-shadow: 
					inset 1px 1px 1px rgba(255,255,255,0.6),
					-1px 0 0 rgba(0,0,0,0.1);
				z-index: 1;
			}

			/* Bevel highlight for the left edge */
			.win2k-folder .folder-icon::after {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				bottom: 0;
				width: 1px;
				background: var(--color-pink-light);
				opacity: 0.5;
			}

			.win2k-folder:hover .folder-icon,
			.win2k-folder:hover .folder-icon::before {
				background-color: var(--color-pink-light);
			}
			.win2k-folder:hover .folder-icon::before {
				background-color: #f0c0d0; /* Extra highlight on hover */
			}

			/* Label text */
			.win2k-folder span {
				font-family: var(--font-body);
				font-size: 1rem;
				font-weight: 500;
				color: var(--color-cream);
				text-shadow: 2px 2px 4px rgba(0,0,0,0.9);
				max-width: 120px;
				word-break: break-word;
				line-height: 1.2;
				transition: color 0.2s ease;
			}

			/* 3-D bevel highlight on top edge */
			.win2k-folder .folder-body::before {
				content: '';
				position: absolute;
				top: 2px;
				left: 6px;
				right: 6px;
				height: 3px;
				background: rgba(255,255,255,0.45);
				border-radius: 2px;
			}

			/* Subtle bottom shadow line */
			.win2k-folder .folder-body::after {
				content: '';
				position: absolute;
				bottom: 4px;
				left: 8px;
				right: 8px;
				height: 2px;
				background: var(--color-pink-shadow);
				border-radius: 1px;
				opacity: 0.4;
			}

			/* Label text */
			.win2k-folder span {
				font-family: var(--font-body);
				font-size: 0.72rem;
				color: var(--color-cream);
				text-shadow: 1px 1px 2px rgba(0,0,0,0.7);
				max-width: 96px;
				word-break: break-word;
				line-height: 1.2;
			}

			/* ─────────────────────────────────────────────────────────
			   Other shared UI components
			───────────────────────────────────────────────────────── */
			.digital-polaroid {
				background: var(--color-cream);
				padding: 10px 10px 40px 10px;
				border: 3px solid var(--color-dusty-pink);
				box-shadow:
					6px 6px 0px var(--color-pink-shadow),
					12px 12px 0px rgba(0,0,0,0.2);
				transform: rotate(-2deg);
				display: inline-block;
			}

			.ornate-frame {
				border: 6px double var(--color-dusty-pink);
				padding: 18px;
				background: var(--color-midnight-purple);
				box-shadow:
					inset 0 0 20px rgba(0,0,0,0.5),
					0 0 0 2px var(--color-pink-shadow);
			}

			/* ─────────────────────────────────────────────────────────
			   Links, inputs, buttons
			───────────────────────────────────────────────────────── */
			a {
				color: var(--color-dusty-pink);
				text-decoration: none;
				transition: all 0.2s ease;
			}
			a:hover {
				color: var(--color-pink-light);
				text-shadow: 0 0 8px var(--color-dusty-pink);
			}

			input, textarea, select {
				background: rgba(30, 0, 48, 0.75);
				border: 2px solid var(--color-dusty-pink);
				color: var(--color-cream);
				padding: 12px;
				font-family: var(--font-body);
				outline: none;
				border-radius: 2px;
			}
			input:focus, textarea:focus {
				border-color: var(--color-pink-light);
				box-shadow: 0 0 10px rgba(212, 132, 154, 0.5);
			}

			button, .btn {
				background: var(--color-dusty-pink);
				color: var(--color-midnight-purple);
				border: 2px solid var(--color-pink-shadow);
				padding: 10px 24px;
				font-family: var(--font-heading);
				font-weight: bold;
				font-size: 0.95rem;
				letter-spacing: 1px;
				transition: all 0.15s ease;
				box-shadow:
					inset 0 2px 3px rgba(255,255,255,0.3),
					inset 0 -2px 3px rgba(0,0,0,0.2),
					3px 3px 0 var(--color-pink-shadow);
			}
			button:hover, .btn:hover {
				background: var(--color-pink-light);
				transform: translate(-1px, -1px);
				box-shadow:
					inset 0 2px 3px rgba(255,255,255,0.3),
					inset 0 -2px 3px rgba(0,0,0,0.2),
					4px 4px 0 var(--color-pink-shadow);
			}
			button:active, .btn:active {
				transform: translate(2px, 2px);
				box-shadow: 1px 1px 0 var(--color-pink-shadow);
			}
		</style>
		<script>
			const cursor = document.getElementById('custom-cursor');
			document.addEventListener('mousemove', (e) => {
				if (cursor) {
					cursor.style.left = e.clientX + 'px';
					cursor.style.top = e.clientY + 'px';
				}
			});
			document.addEventListener('mousedown', () => {
				cursor?.classList.add('clicking');
			});
			document.addEventListener('mouseup', () => {
				cursor?.classList.remove('clicking');
			});
		</script>
	</body>
</html>
