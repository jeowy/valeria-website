---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Bespoke Commissions | Valeria">
	<main>
		<div class="ornate-frame">
			<h1>Bespoke Commissions</h1>
			<p>B2C funnel for private clients (vision/collaboration).</p>
			
			<form action="#" method="POST">
				<div class="field">
					<label for="name">Your Name</label>
					<input type="text" id="name" name="name" required placeholder="Lucia..." />
				</div>
				<div class="field">
					<label for="email">Email Address</label>
					<input type="email" id="email" name="email" required placeholder="lucia@example.com" />
				</div>
				<div class="field">
					<label for="medium">Preferred Medium</label>
					<select id="medium" name="medium">
						<option value="canvas">Canvas Painting</option>
						<option value="wood">Wood Panel</option>
						<option value="objeto">Mixed Media / Objeto</option>
					</select>
				</div>
				<div class="field">
					<label for="story">The Story Behind This Piece</label>
					<textarea id="story" name="story" rows="5" placeholder="What dream or memory should we capture?"></textarea>
				</div>
				<button type="submit">Begin Collaboration</button>
			</form>
		</div>
		<nav>
			<a href="/">← Back Home</a>
		</nav>
	</main>
</Layout>

<style>
	main { padding: 4rem; display: flex; flex-direction: column; align-items: center; }
	.ornate-frame { max-width: 600px; width: 100%; }
	h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-marigold); }
	p { margin-bottom: 2rem; color: var(--color-magenta); }
	form { display: flex; flex-direction: column; gap: 1.5rem; }
	.field { display: flex; flex-direction: column; gap: 0.5rem; }
	label { font-family: var(--font-heading); font-size: 0.9rem; text-transform: uppercase; color: var(--color-marigold); }
	nav { margin-top: 4rem; }
</style>
